# Copy to .env and fill in. Never commit .env.
# Make random values with:  openssl rand -hex 24

# Domain (or subdomain) pointing at this server, e.g. aq.yourcompany.com
DOMAIN=aq.example.com

# Database password: letters and digits only.
POSTGRES_PASSWORD=change-me

# Shared secret for capture computers (also used to push reference data). At least 16 characters.
AGENT_TOKEN=change-me-to-a-long-random-string

# Dashboard logins: name:password pairs, comma separated. Names appear in the audit log.
DASHBOARD_USERS=admin:change-me

# Optional: chat webhook for alerts (Slack/Discord incoming webhook URL, or
# https://api.telegram.org/bot<token>/sendMessage?chat_id=<id>). Leave empty for dashboard-only alerts.
ALERT_WEBHOOK_URL=

# Readings with lower OCR confidence than this go to the review queue (0-1).
REVIEW_CONFIDENCE=0.6
